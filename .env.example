# Copy to .env; never commit credentials.
COMPOSE_PROJECT_NAME=trips
OTP_HOST=trips.simovi.org
OTP_IMAGE=opentripplanner/opentripplanner:2.10.0
OTP_DATA_DIR=./data

# On Linux, set these to the owner of OTP_DATA_DIR (id -u / id -g).
OTP_UID=1000
OTP_GID=1000

TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Must name an ACME resolver already configured in the existing Traefik.
# Leave empty if Traefik supplies certificates through its default TLS store.
TRAEFIK_CERT_RESOLVER=letsencrypt

# Required. Follow README to append a single-quoted bcrypt htpasswd entry.
# Keep dollar signs literal; do not double them in this .env file.
OTP_AUTH_USERS=

# Heap must be smaller than the container memory limit (native JVM overhead).
OTP_JAVA_OPTIONS="-Xmx4g -XX:+ExitOnOutOfMemoryError"
OTP_MEMORY_LIMIT=6g
OTP_CPUS=2
OTP_BUILD_JAVA_OPTIONS="-Xmx8g -XX:+ExitOnOutOfMemoryError"
OTP_BUILD_MEMORY_LIMIT=12g
OTP_BUILD_CPUS=4
OTP_HEALTH_START_PERIOD=180s
